NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Resend: chave de envio restrita ao domínio verificado. Nunca exponha no frontend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=São Bento Dobrões <pedidos@saobentodobroes.com>

# Mercado Pago CardForm / Checkout Transparente.
MERCADO_PAGO_MODE=disabled
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_SELLER_ID=
MERCADO_PAGO_APPLICATION_ID=
# Habilite o evento Pagamentos (payment) em APP_URL/api/webhooks/mercadopago.
WEBHOOK_SECRET=

# Painel administrativo em APP_URL/admin.
# ADMIN_PASSWORD: senha longa e exclusiva, mínimo 12 caracteres.
# ADMIN_SESSION_SECRET: segredo aleatório do servidor, mínimo 32 caracteres.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Produção/Vercel: use a URI do Supabase Transaction Pooler (porta 6543).
# Mantenha esta variável como Secret/Sensitive. Nunca exponha no frontend.
DATABASE_URL=

# Desenvolvimento local sem DATABASE_URL continua usando SQLite.
DATABASE_PATH=backend/data/shop.sqlite

# Pedidos que continuam "pending" sem iniciar pagamento são excluídos automaticamente.
# Exclusão automática desativada. Pedidos são removidos do painel manualmente.

# Correios direto: use homologation para testes e production após homologar.
CORREIOS_MODE=disabled
CORREIOS_USER=
CORREIOS_API_PASSWORD=
CORREIOS_POSTING_CARD=
CORREIOS_PAC_CODE=
CORREIOS_SEDEX_CODE=
SHIPPING_ORIGIN_CEP=
SHIPPING_UNIT_WEIGHT_G=60
SHIPPING_PACKAGE_WEIGHT_G=
SHIPPING_LENGTH_CM=
SHIPPING_WIDTH_CM=
SHIPPING_BASE_HEIGHT_CM=
SHIPPING_UNIT_HEIGHT_CM=

# SuperFrete: mantenha o token somente no servidor.
# SHIPPING_PROVIDER=superfrete
SUPERFRETE_TOKEN=
SUPERFRETE_SERVICES=1,2,17

# Em produção, configure apenas o proxy confiável real. Nunca use true.
# TRUST_PROXY=loopback


# Informações públicas do responsável e canal de privacidade
PRIVACY_CONTROLLER=
PRIVACY_EMAIL=

# Identificação pública do fornecedor (Decreto 7.962/2013)
STORE_LEGAL_NAME=
STORE_DOCUMENT=
STORE_ADDRESS=
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=

